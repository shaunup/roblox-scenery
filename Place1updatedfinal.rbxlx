			<Item class="LocalScript" referent="RBXE3A02B2DD66248448C3098FA91B4D987">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local player = game.Players.LocalPlayer
local frame = gui:WaitForChild("Frame")
local paperLabel = frame:WaitForChild("PaperLabel")
local stickLabel = frame:WaitForChild("StickLabel")
local candleLabel = frame:WaitForChild("CandleLabel")
local glueLabel = frame:WaitForChild("GlueLabel")

-- Wait for materials folder to exist
local materials = player:WaitForChild("Materials")
local paper = materials:WaitForChild("Paper")
local stick = materials:WaitForChild("Stick")
local candle = materials:WaitForChild("Candle")
local glue = materials:WaitForChild("Glue")


-- Update display
local function updateInventory()
	paperLabel.Text = "Paper: " .. paper.Value
	stickLabel.Text = "Stick: " .. stick.Value
	candleLabel.Text = "Candle: " .. candle.Value
	glueLabel.Text = "Glue: " .. glue.Value
end

-- Run once on start
updateInventory()

-- Auto update whenever any value changes
paper.Changed:Connect(updateInventory)
stick.Changed:Connect(updateInventory)
candle.Changed:Connect(updateInventory)
glue.Changed:Connect(updateInventory)]]></ProtectedString>
