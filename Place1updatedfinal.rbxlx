		<Item class="LocalScript" referent="RBX50ED2E36DA6D4FCC90ADA2E69C078C54">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local RS = game:GetService("ReplicatedStorage")

-- Background ambient music
local bg = Instance.new("Sound", SoundService)
bg.SoundId = "rbxassetid://140010097046245"
bg.Volume  = 0.4
bg.Looped  = true
bg:Play()

-- Listen for the bonfire music playing → duck the background
local PlayMusic = RS:WaitForChild("Remotes"):WaitForChild("PlayMusic")
PlayMusic.OnClientEvent:Connect(function()
	bg.Volume = 0   -- silence background while bonfire music plays
end)

-- Listen for cinematic music starting → duck again
local LanternReleased = RS:WaitForChild("Remotes"):WaitForChild("LanternReleased")
LanternReleased.OnClientEvent:Connect(function()
	bg.Volume = 0   -- cinematic script handles its own music
end)]]></ProtectedString>
