			<Item class="LocalScript" referent="RBX714f31f3fe554d55b3f077d16fe12e94">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local players = game:GetService("Players")
local player = players.LocalPlayer

local trigger = workspace:WaitForChild("SoundQuizTrigger")
local proximityPrompt = trigger:WaitForChild("ProximityPrompt")

local rounds = {
	{ sound = "RainSound", options = {"Rain", "Wind", "Mouse Click", "Birds"}, answer = "Rain" },
	{ sound = "WindSound", options = {"Birds", "Wind", "Rain", "Mouse Click"}, answer = "Wind" },
	{ sound = "MouseClickSound", options = {"Mouse Click", "Rain", "Birds", "Wind"}, answer = "Mouse Click" },
	{ sound = "BirdSound", options = {"Wind", "Mouse Click", "Rain", "Birds"}, answer = "Birds" },
}

local quizActive = false

proximityPrompt.Triggered:Connect(function(triggeringPlayer)
	if triggeringPlayer ~= player or quizActive then return end

	quizActive = true
	proximityPrompt.Enabled = false -- hide the prompt while quiz is active

	local gui = player.PlayerGui:WaitForChild("SoundQuizGui")
	local frame = gui:WaitForChild("Frame")
	local questionLabel = frame:WaitForChild("QuestionLabel")
	local buttons = {
		frame:WaitForChild("Button1"),
		frame:WaitForChild("Button2"),
		frame:WaitForChild("Button3"),
		frame:WaitForChild("Button4"),
	}

	local score = 0

	for i, round in ipairs(rounds) do
		local sound = trigger:WaitForChild(round.sound)
		sound:Play()

		questionLabel.Text = "Round " .. i .. ": What sound did you hear?"
		for j, btn in ipairs(buttons) do
			btn.Text = round.options[j]
		end
		gui.Enabled = true

		local answered = false
		local connections = {}
		for j, btn in ipairs(buttons) do
			connections[j] = btn.MouseButton1Click:Connect(function()
				if answered then return end
				answered = true
				if btn.Text == round.answer then
					score = score + 1
					btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100) -- green
				else
					btn.BackgroundColor3 = Color3.fromRGB(200, 100, 100) -- red
				end
				task.wait(1)
				for _, b in ipairs(buttons) do
					b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				end
			end)
		end

		repeat task.wait(0.1) until answered
		for _, c in ipairs(connections) do c:Disconnect() end
		sound:Stop()
		task.wait(0.5)
	end

	gui.Enabled = false

	if score >= 3 then
		print("Passed! Score: " .. score .. "/4")
		-- TODO: give lantern frame item here
	else
		print("Try again! Score: " .. score .. "/4")
		proximityPrompt.Enabled = true -- let them retry
		quizActive = false
	end
end)]]></ProtectedString>
